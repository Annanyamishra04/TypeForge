# --- Backend (server/) --------------------------------------------------
# MongoDB Atlas (or any Mongo) connection string. Leave empty to run the
# API without persistence — it will start normally and honestly report
# "not_configured" instead of pretending to save results.
MONGODB_URI=

# Port the Express API listens on.
PORT=5000

# Origin allowed by CORS in production (your deployed frontend URL).
# In local development this defaults to http://localhost:5173 if unset.
CLIENT_URL=

# Secret used to sign/verify JWTs. Required for registration, login,
# and every protected route — generate a long random value and never
# commit the real one (e.g. `openssl rand -hex 32`).
JWT_SECRET=

# AI Coach (optional). Leave all three empty to run entirely on the
# deterministic "Performance Coach" fallback — the product works fully
# without them. When set, they must all be set together. The server
# never sends personal data to this provider — only anonymized
# aggregate performance numbers (see server/services/coachService.js).
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-4-6

# --- Frontend (src/) ------------------------------------------------------
# Base URL of the backend API, including the /api prefix.
# Defaults to http://localhost:5000/api if unset.
VITE_API_URL=
